{
  "repository": "nuxtjp/nuxtjp-ui",
  "purpose": "日本語サービスのUIを、共通の部品・テーマ・言語設定で揃えられます。 / Add consistent Japanese-first UI components, theme tokens and locale behavior to a Nuxt application.",
  "responsibility_boundary": "Own the documented Nuxt/browser interface and its public contracts. Account authority, external effects, product state and production hosting remain explicit consumer responsibilities.",
  "packages": [
    {
      "manifest": "package.json",
      "package": "@nuxtjp/ui",
      "ecosystem": "npm",
      "description": "Nuxt UI derivative with a traceable Japanese public-design profile",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./core": {
            "types": "./dist/runtime/core/index.d.ts",
            "import": "./dist/runtime/core/index.js"
          }
        },
        "bin": {},
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build": "pnpm run build:module && pnpm run build:playground",
        "build:module": "nuxt-module-build build",
        "build:playground": "nuxt build playground",
        "compliance:verify": "node scripts/verify-compliance.mjs",
        "dev": "pnpm run dev:prepare && nuxt dev playground",
        "dev:prepare": "nuxt-module-build prepare && nuxt-module-build build --stub && nuxt prepare playground",
        "typecheck": "pnpm run dev:prepare && vue-tsc --noEmit --project tsconfig.json && nuxt typecheck playground",
        "test": "pnpm run dev:prepare && vitest run && pnpm run test:dependency-security && pnpm run test:consumer-security",
        "upstream:check": "node scripts/check-upstream.mjs",
        "prepack": "pnpm run compliance:verify && pnpm run test && pnpm run typecheck && pnpm run build",
        "test:dependency-security": "node --test security/dependency-security.check.cjs",
        "test:consumer-security": "node --test scripts/consumer-security.check.mjs"
      }
    },
    {
      "manifest": "packages/nuxt-dependency-security/package.json",
      "package": "@nuxtjp/dependency-security",
      "ecosystem": "npm",
      "description": "Explicit pnpm backport configuration and active dependency regression checks without Nuxt peers",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./types/index.d.mts",
            "import": "./index.mjs"
          },
          "./policy": "./dependency-versions.json",
          "./installed-dependencies": {
            "types": "./resolved-dependency.d.cts",
            "import": "./resolved-dependency.cjs",
            "require": "./resolved-dependency.cjs"
          }
        },
        "bin": {
          "nuxtjp-security-config": "./apply.mjs",
          "nuxtjp-security-check": "./check.mjs"
        },
        "main": null,
        "types": "./types/index.d.mts"
      },
      "declared_commands": {
        "build": "node --check index.mjs && node --check project.mjs && node --check apply.mjs && node --check check.mjs && node --check resolved-dependency.cjs",
        "test": "node --test test/*.test.mjs",
        "typecheck": "tsc --strict --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 test/public-types.mts"
      }
    },
    {
      "manifest": "packages/nuxt-managed-resources/package.json",
      "package": "@nuxtjp/managed-resources",
      "ecosystem": "npm",
      "description": "Provider-neutral managed-resource presentation for Nuxt",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./types": {
            "types": "./dist/runtime/shared/types.d.ts",
            "import": "./dist/runtime/shared/types.js"
          },
          "./guards": {
            "types": "./dist/runtime/shared/guards.d.ts",
            "import": "./dist/runtime/shared/guards.js"
          },
          "./core": {
            "types": "./dist/runtime/shared/resources.d.ts",
            "import": "./dist/runtime/shared/resources.js"
          },
          "./schema": "./schemas/managed-resources-v1.schema.json"
        },
        "bin": {},
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build": "nuxt-module-build build",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run",
        "prepack": "pnpm run build"
      }
    },
    {
      "manifest": "packages/nuxt-management-layout/package.json",
      "package": "@nuxtjp/management-layout",
      "ecosystem": "npm",
      "description": "Reusable Nuxt management dashboard Layer built on NuxtJP UI",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./nuxt.config.ts",
            "import": "./nuxt.config.ts"
          },
          "./core": {
            "types": "./core/index.ts",
            "import": "./core/index.ts"
          }
        },
        "bin": {},
        "main": "./nuxt.config.ts",
        "types": null
      },
      "declared_commands": {
        "build": "nuxt build playground",
        "compliance:verify": "node scripts/verify-contract.mjs",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json && nuxt typecheck playground",
        "test": "vitest run",
        "upstream:check": "node scripts/check-upstream.mjs",
        "prepack": "pnpm run compliance:verify && pnpm run test && pnpm run typecheck && pnpm run build"
      }
    },
    {
      "manifest": "packages/nuxt-operations-console/package.json",
      "package": "@nuxtjp/operations-console",
      "ecosystem": "npm",
      "description": "Provider-neutral operational readiness and network-control presentation for Nuxt",
      "interfaces": {
        "exports": {
          ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs"
          },
          "./core": {
            "types": "./dist/runtime/core/index.d.ts",
            "import": "./dist/runtime/core/index.js"
          },
          "./schema/credential-readiness": "./schemas/credential-readiness-v1.schema.json",
          "./schema/network-observations": "./schemas/network-observations-v1.schema.json",
          "./schema/network-controls": "./schemas/network-controls-v1.schema.json",
          "./schema/control-coverage": "./schemas/control-coverage-snapshot-v2.schema.json",
          "./schema/network-topology": "./schemas/network-topology-v1.schema.json"
        },
        "bin": {},
        "main": "./dist/module.mjs",
        "types": "./dist/types.d.mts"
      },
      "declared_commands": {
        "build": "nuxt-module-build build && nuxt build playground",
        "typecheck": "vue-tsc --noEmit --project tsconfig.json",
        "test": "vitest run",
        "prepack": "pnpm run build"
      }
    }
  ],
