              "uses": "actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1",
              "condition": null
            },
            {
              "name": "Detect upstream changes without updating files",
              "run": "set +e\nnode scripts/check-upstream.mjs > upstream-report.json\nresult=$?\nset -e\necho \"result=$result\" >> \"$GITHUB_OUTPUT\"\n{\n  echo '## Primary-source review'\n  echo\n  echo 'This workflow only detects changes. It never updates the lock or implementation.'\n  echo\n  echo '```json'\n  cat upstream-report.json\n  echo '```'\n} >> \"$GITHUB_STEP_SUMMARY\"\n",
              "uses": null,
              "condition": null
            },
            {
              "name": "Require review for a change or unavailable source",
              "run": "echo \"Primary-source review required (exit ${{ steps.detect.outputs.result }}).\"\nexit 1\n",
              "uses": null,
              "condition": "steps.detect.outputs.result != '0'"
            }
          ]
        }
      ]
