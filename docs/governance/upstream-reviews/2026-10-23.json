{
  "schemaVersion": 1,
  "reviewDate": "2026-10-23",
  "issue": 38,
  "documentVersion": "2.18.1",
  "implementationBaseline": "2.16.0",
  "runtimeChanged": false,
  "conformancePromoted": false,
  "decisions": {
    "font": {
      "reason": "Only Figma Sans drops Apple/system font names. The Vue module already omits those names and deliberately retains Japanese offline fallbacks; no generated token or remote font import is adopted.",
      "requirements": [
        "NJDS-CMP-NUXT-001"
      ],
      "disposition": "retain-local"
    },
    "docs": {
      "reason": "Guideline links, Storybook presentation and documentation are reference material, not shipped Vue code. Record links without copying their implementation or claiming conformance.",
      "requirements": [
        "DADS-V2-CMP-USAGE-001"
      ],
      "disposition": "reference-only"
    },
    "tools": {
      "reason": "Reference-repository CI, agents, development dependencies and exports do not control this Nuxt package. No upstream instruction, workflow, React dependency or removed v1 export is imported.",
      "requirements": [
        "NJDS-CMP-NUXT-001"
      ],
      "disposition": "reference-only"
    },
    "breadcrumb": {
      "reason": "Upstream changes ol/li to p/span while retaining labelled navigation/current-page semantics. No NuxtJp breadcrumb exists; keep coverage planned, and assess semantics when implementing it instead of replacing unrelated lists.",
      "requirements": [
        "DADS-V2-CMP-A11Y-001"
      ],
      "disposition": "not-adopted"
    },
    "modal": {
      "reason": "The fixed-width example changes placeholder content; React v1 Dialog is retired. No local DADS modal exists. Future adoption must test focus entry/return, Escape and accessible naming.",
      "requirements": [
        "DADS-V2-CMP-A11Y-001"
      ],
      "disposition": "not-adopted"
    },
    "switch": {
      "reason": "New HTML custom elements/React controlled switches require state, keyboard and disabled-state contracts. No local DADS switch exists; do not install custom-element JavaScript into Vue.",
      "requirements": [
        "DADS-V2-CMP-A11Y-001"
      ],
      "disposition": "not-adopted"
    },
    "controls": {
      "reason": "React button sizing and native-disabled checkbox/radio styling are reference implementation changes. This module uses Nuxt UI controls, not copied React CSS. Existing step navigation receives browser keyboard/disabled/focus regression coverage.",
      "requirements": [
        "DADS-V2-CMP-A11Y-001",
        "NJDS-CMP-NUXT-001"
      ],
      "disposition": "retain-local"
    },
    "list": {
      "reason": "React renames its private spacing variable to avoid a Tailwind collision. No copied list CSS or --spacing override exists in this module; semantic MetricGrid dl/dt/dd is retained and browser-tested.",
      "requirements": [
        "DADS-V2-CMP-A11Y-001"
      ],
      "disposition": "retain-local"
    },
    "badge": {
      "reason": "React changes the rounded utility to its DADS token name. StatusBadge uses Nuxt UI UBadge with textual state and does not import that class. Keep planned DADS chip-label coverage and test text exposure.",
      "requirements": [
        "DADS-V2-CMP-A11Y-001"
      ],
      "disposition": "retain-local"
    },
    "new-components": {
      "reason": "React v2 Card/PageNavigation/ResourceList/SearchBox/StepNavigation are separate reference implementations. No framework port is adopted; ProcessStepper stays a generic UStepper wrapper with planned DADS coverage and browser regression tests.",
      "requirements": [
        "DADS-V2-CMP-USAGE-001",
        "DADS-V2-CMP-A11Y-001"
      ],
      "disposition": "not-adopted"
    },
    "assets": {
      "reason": "Example-only images are not copied or bundled. Their third-party rights and example content are not required by the Vue runtime.",
      "requirements": [
        "NJDS-CMP-NUXT-001"
      ],
      "disposition": "not-adopted"
    }
  },
