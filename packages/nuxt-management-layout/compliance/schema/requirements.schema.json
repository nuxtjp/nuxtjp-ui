{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuxt.jp/schemas/management-layout-requirements.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "requirements"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "requirements": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "sourceIds", "level", "status", "artifacts", "tests"],
      "properties": {
        "id": { "type": "string", "pattern": "^(NUXT-LAYER|NJDS-LAYOUT|DADS-LAYOUT|DASH-LAYOUT)-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "sourceIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "level": { "enum": ["must", "should", "may"] },
        "status": { "enum": ["planned", "implemented", "verified", "exception", "not-applicable"] },
        "artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "tests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exceptionReason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["implemented", "verified"] } } },
          "then": {
            "properties": {
              "artifacts": { "type": "array", "minItems": 1 },
              "tests": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": {
            "required": ["evidence"],
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "status": { "const": "exception" } } },
          "then": {
            "required": ["exceptionReason"],
            "properties": { "exceptionReason": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
