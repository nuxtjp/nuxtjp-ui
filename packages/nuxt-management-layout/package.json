{
  "name": "@nuxtjp/management-layout",
  "version": "0.5.0",
  "description": "Reusable Nuxt management dashboard Layer built on NuxtJP UI",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "nuxt",
    "vue",
    "nuxt-layer",
    "dashboard",
    "accessibility",
    "management-ui",
    "japanese-design-system"
  ],
  "homepage": "https://github.com/nuxtjp/nuxtjp-ui/tree/main/packages/nuxt-management-layout#readme",
  "bugs": {
    "url": "https://github.com/nuxtjp/nuxtjp-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxtjp/nuxtjp-ui.git",
    "directory": "packages/nuxt-management-layout"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "^22.19.0 || ^24.11.0",
    "pnpm": ">=10 <11"
  },
  "files": [
    "app",
    "compliance",
    "core",
    "docs",
    "nuxt.config.ts",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "NOTICE",
    "LICENSE-PREVIOUS"
  ],
  "main": "./nuxt.config.ts",
  "exports": {
    ".": {
      "types": "./nuxt.config.ts",
      "import": "./nuxt.config.ts"
    },
    "./core": {
      "types": "./core/index.ts",
      "import": "./core/index.ts"
    }
  },
  "scripts": {
    "build": "nuxt build playground",
    "compliance:verify": "node scripts/verify-contract.mts",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json && nuxt typecheck playground",
    "test": "vitest run",
    "upstream:check": "node scripts/check-upstream.mjs",
    "prepack": "pnpm run compliance:verify && pnpm run test && pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": {
    "@nuxtjp/ui": "0.2.0",
    "nuxt": "^4.6.2",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "@nuxtjp/ui": "0.2.0",
    "@types/node": "24.12.0",
    "ajv": "8.20.0",
    "nuxt": "4.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "vue-tsc": "3.3.13"
  }
}
