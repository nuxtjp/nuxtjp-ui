{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nuxtjp://operations/network-topology/v1",
  "title": "NuxtJP network topology projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "external_actions",
    "projection_mode",
    "overall_status",
    "summary",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": { "const": "nuxtjp://operations/network-topology/v1" },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "external_actions": { "const": false },
    "projection_mode": {
      "enum": ["live-local", "mixed-local-and-declared", "simulation"]
    },
    "overall_status": { "enum": ["healthy", "attention", "unknown"] },
    "summary": { "$ref": "#/$defs/summary" },
    "nodes": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": ["healthy", "attention", "unknown", "observed"]
    },
    "evidenceMode": {
      "enum": ["live-observation", "declared", "not-connected"]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_count", "network_count", "instance_count"],
      "properties": {
        "project_count": { "$ref": "#/$defs/count" },
        "network_count": { "$ref": "#/$defs/count" },
        "instance_count": { "$ref": "#/$defs/count" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "label", "kind", "zone", "status", "source",
        "evidence_mode", "isolation_mode", "finding_codes",
        "column", "row", "metrics"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$"
        },
        "kind": {
          "enum": ["observer", "boundary-monitor", "interface", "environment"]
        },
        "zone": { "$ref": "#/$defs/identifier" },
        "status": { "$ref": "#/$defs/status" },
        "source": { "$ref": "#/$defs/identifier" },
        "evidence_mode": { "$ref": "#/$defs/evidenceMode" },
        "isolation_mode": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "finding_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "column": { "type": "integer", "minimum": 1, "maximum": 32 },
        "row": { "type": "integer", "minimum": 1, "maximum": 32 },
        "metrics": { "$ref": "#/$defs/metrics" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source_node_id", "target_node_id",
        "relation", "status", "evidence_mode"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source_node_id": { "$ref": "#/$defs/identifier" },
        "target_node_id": { "$ref": "#/$defs/identifier" },
        "relation": { "const": "observes" },
        "status": { "$ref": "#/$defs/status" },
        "evidence_mode": { "$ref": "#/$defs/evidenceMode" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_count", "edge_count", "healthy_count",
        "attention_count", "unknown_count", "observed_count"
      ],
      "properties": {
        "node_count": { "$ref": "#/$defs/count" },
        "edge_count": { "$ref": "#/$defs/count" },
        "healthy_count": { "$ref": "#/$defs/count" },
        "attention_count": { "$ref": "#/$defs/count" },
        "unknown_count": { "$ref": "#/$defs/count" },
        "observed_count": { "$ref": "#/$defs/count" }
      }
    }
  }
}
