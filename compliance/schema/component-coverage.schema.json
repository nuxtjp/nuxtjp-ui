{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuxt.jp/schemas/component-coverage.schema.json",
  "title": "DADS component adoption coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "sourceVersion", "checkedAt", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "sourceId": { "const": "dads-component-index" },
    "sourceVersion": { "const": "2.16.0" },
    "checkedAt": { "type": "string", "format": "date" },
    "components": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nameJa", "profile", "status", "sourceUrl", "requirementIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
        "nameJa": { "type": "string", "minLength": 1, "maxLength": 200 },
        "profile": { "enum": ["core", "conditional", "not-default"] },
        "status": { "enum": ["not-assessed", "planned", "implemented", "verified", "not-applicable"] },
        "sourceUrl": { "type": "string", "format": "uri" },
        "localComponent": { "type": ["string", "null"], "maxLength": 500 },
        "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
